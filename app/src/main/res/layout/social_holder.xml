<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/holderItem">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:scaleType="centerCrop"
            android:id="@+id/image"
            android:src="@drawable/jalo"/>
        <ImageButton
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/thumb_up_24"
            android:id="@+id/like"
            android:layout_marginStart="10dp"
            android:layout_below="@id/image"/>
        <ImageButton
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/thumb_down_alt_24"
            android:id="@+id/unlike"
            android:layout_toEndOf="@id/like"
            android:layout_marginStart="10dp"
            android:layout_below="@id/image"/>
        <ImageButton
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:src="@drawable/favorite_24"
            android:layout_toEndOf="@id/unlike"
            android:id="@+id/favorite"
            android:layout_below="@id/image"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_below="@id/image"
            android:text="5 hours ago"
            android:textSize="15sp"
            android:id="@+id/postedTime"
            android:textColor="#024C0D"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_marginTop="10dp"
            android:layout_below="@id/like"
            android:id="@+id/postedBy"
            android:text="By Calvince Owino Jalikoa The CEo JalSoft"
            android:textSize="17sp"
            android:paddingStart="20dp"
            android:textStyle="bold"
            android:textColor="#180683"/>
    </RelativeLayout>

</LinearLayout>