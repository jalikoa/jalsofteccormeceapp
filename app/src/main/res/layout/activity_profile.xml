<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#eee"
    tools:context=".ProfileActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:orientation="horizontal"
        android:background="@drawable/nav_bt_bg2"
        android:id="@+id/top">
        <ImageButton
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/round_arrow_back_24"
            android:background="@drawable/nav_bt_bg2"
            android:id="@+id/backButton"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:fontFamily="sans-serif-condensed"
            android:layout_marginTop="5dp"
            android:textColor="#ede"
            android:textSize="20sp"
            android:layout_marginStart="40dp"
            android:text="Manage your profile"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/profileCred">
        <androidx.cardview.widget.CardView
            android:layout_marginTop="40dp"
            android:layout_width="200dp"
            android:background="@drawable/rounded_corner22"
            android:layout_height="200dp"
            app:cardCornerRadius="160dp"
            app:cardElevation="4dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/jalo"
                android:layout_gravity="start"
                android:scaleType="centerCrop" />
        </androidx.cardview.widget.CardView>
        <LinearLayout
            android:layout_width="match_parent"
            android:padding="20dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="start">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="#7E3B1B"
                android:text="Name : Calvince Owino"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:layout_marginTop="10dp"
                android:textColor="#7E3B1B"
                android:text="Email : t313jalikoa@gmail.com"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:layout_marginTop="10dp"
                android:textColor="#7E3B1B"
                android:text="Phone : +254 799 311 413"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:layout_marginTop="10dp"
                android:textColor="#7E3B1B"
                android:text="Business : Local vendor retailer"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:layout_marginTop="10dp"
                android:textColor="#7E3B1B"
                android:text="Gender : male"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="1dp">
            <ImageButton
                android:layout_width="70dp"
                android:layout_marginStart="40dp"
                android:layout_height="50dp"
                android:src="@drawable/edit_24"
                android:backgroundTint="#ED3F51B5"/>
            <ImageButton
                android:layout_width="70dp"
                android:layout_height="50dp"
                android:layout_marginStart="20dp"
                android:src="@drawable/delete_24"
                android:backgroundTint="#E91E63"/>
        </LinearLayout>

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:id="@+id/nav_bt"
        android:background="@drawable/nav_bott_bg"
        android:layout_alignParentBottom="true"
        android:paddingEnd="20dp"
        android:paddingStart="20dp"
        android:orientation="horizontal">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/nav_holder">
            <ImageButton
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:id="@+id/home_nav"
                android:layout_alignParentStart="true"
                android:contentDescription="@string/app_name"
                android:src="@drawable/home_24"/>
            <ImageButton
                android:layout_width="50dp"
                android:contentDescription="@string/app_name"
                android:layout_height="50dp"
                android:id="@+id/profile_nav"
                android:layout_alignParentEnd="true"
                android:src="@drawable/person_24"/>
        </RelativeLayout>

    </LinearLayout>

</RelativeLayout>